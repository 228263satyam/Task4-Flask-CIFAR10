    {
      "name": "04 - Extended Validation Tests",
      "item": [
        {
          "name": "TC07 - Wrong Form Field Name",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:5000/predict",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "5000",
              "path": [
                "predict"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "test_image.png"
                }
              ]
            },
            "description": "Field is named 'file' instead of 'image'. Expect 400."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
