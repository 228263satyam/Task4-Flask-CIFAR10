        {
          "name": "TC11 - Second Valid Image (Probability Integrity)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:5000/predict",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "5000",
              "path": [
                "predict"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "test_image_2.png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "const response = pm.response.json();",
                  "pm.test(\"Prediction successful\", function () {",
                  "    pm.expect(response.success).to.eql(true);",
                  "});",
                  "pm.test(\"Prediction is valid CIFAR-10 class\", function () {",
                  "    const classes = [\"airplane\",\"automobile\",\"bird\",\"cat\",\"deer\",\"dog\",\"frog\",\"horse\",\"ship\",\"truck\"];",
                  "    pm.expect(classes).to.include(response.prediction);",
                  "});",
                  "pm.test(\"Exactly 10 class probabilities\", function () {",
                  "    pm.expect(Object.keys(response.probabilities)).to.have.lengthOf(10);",
                  "});",
                  "pm.test(\"Probabilities sum to ~1\", function () {",
                  "    const s = Object.values(response.probabilities).reduce((a,b)=>a+b,0);",
                  "    pm.expect(s).to.be.within(0.98,1.02);",
                  "});",
                  "pm.test(\"Top probability equals confidence\", function () {",
                  "    pm.expect(Math.max(...Object.values(response.probabilities))).to.be.closeTo(response.confidence,0.001);",
                  "});",
                  "pm.test(\"Response time under 5000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
