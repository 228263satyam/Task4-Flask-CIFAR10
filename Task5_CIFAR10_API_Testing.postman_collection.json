    {
      "name": "01 - Health Tests",
      "item": [
        {
          "name": "TC01 - Home Endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:5000/",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "5000",
              "path": [
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "const response = pm.response.json();",
                  "pm.test(\"API status is running\", function () {",
                  "    pm.expect(response.status).to.eql(\"running\");",
                  "});",
                  "pm.test(\"Dataset is CIFAR-10\", function () {",
                  "    pm.expect(response.dataset).to.eql(\"CIFAR-10\");",
                  "});",
                  "pm.test(\"Model is CNN\", function () {",
                  "    pm.expect(response.model).to.eql(\"CNN\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
