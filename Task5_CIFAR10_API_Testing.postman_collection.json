    {
      "name": "02 - Prediction Tests",
      "item": [
        {
          "name": "TC03 - Valid Image Prediction",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "test_image.png"
                }
              ]
            },
            "url": {
              "raw": "http://127.0.0.1:5000/predict",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "5000",
              "path": [
                "predict"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "const response = pm.response.json();",
                  "pm.test(\"Prediction successful\", function () {",
                  "    pm.expect(response.success).to.eql(true);",
                  "});",
                  "pm.test(\"Prediction exists\", function () {",
                  "    pm.expect(response.prediction).to.exist;",
                  "});",
                  "pm.test(\"Confidence exists\", function () {",
                  "    pm.expect(response.confidence).to.exist;",
                  "});",
                  "pm.test(\"Confidence is between 0 and 1\", function () {",
                  "    pm.expect(response.confidence).to.be.at.least(0);",
                  "    pm.expect(response.confidence).to.be.at.most(1);",
                  "});",
                  "pm.test(\"Prediction is valid CIFAR-10 class\", function () {",
                  "    const classes = [\"airplane\",\"automobile\",\"bird\",\"cat\",\"deer\",\"dog\",\"frog\",\"horse\",\"ship\",\"truck\"];",
                  "    pm.expect(classes).to.include(response.prediction);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
